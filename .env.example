# ============================================================
# Creem configuration (Merchant of Record for digital products)
# Set these in Vercel Project Settings → Environment Variables.
#
# The serverless function /api/checkout.js FAILS LOUDLY if CREEM_API_KEY
# is missing — the secret key never appears in client code.
# ============================================================

# CREEM_API_KEY — REQUIRED (SERVER-SIDE ONLY, never expose to browser)
# Get it from Creem Dashboard → Developers → API Keys.
#   Test mode: prefixed creem_test_   → calls https://test-api.creem.io
#   Live mode: no test prefix         → calls https://api.creem.io
# /api/checkout.js auto-detects test vs live from this prefix.
CREEM_API_KEY=creem_test_xxxxxxxxxxxxxxxxxxxxxxxx

# CREEM_PRODUCT_ID — optional override (defaults to the ID hardcoded in /api/checkout.js)
CREEM_PRODUCT_ID=prod_7G2zTME0gRxz09wGHsG0L4

# CREEM_SUCCESS_URL — optional override (fallback redirect after payment).
# For the embedded overlay we cancel this redirect via Creem.close() in
# onComplete, but it's still useful as a hosted-flow fallback.
CREEM_SUCCESS_URL=https://supernova-1sn7.vercel.app/
